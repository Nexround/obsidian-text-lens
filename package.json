{
  "name": "text-lens",
  "version": "1.4.0",
  "description": "Obsidian plugin: on-device image OCR via PaddleOCR or experimental Windows/macOS native OCR",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-native-ocr.mjs",
    "probe:windows": "node scripts/probe-windows-ocr.mjs",
    "probe:macos": "node scripts/probe-macos-ocr.mjs",
    "build:helper": "node scripts/build-macos-helper.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "deploy": "node esbuild.config.mjs production && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "onnxruntime-node": "^1.27.0",
    "ppu-paddle-ocr": "^6.0.0"
  }
}
